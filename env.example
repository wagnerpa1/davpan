NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# SMTP Settings
SMTP_HOST=your-smtp-host.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
# Web Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Notification delivery mode: outbox (recommended) or direct
NOTIFICATION_DELIVERY_MODE=outbox
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=8
INTERNAL_CRON_SECRET=your_cron_secret

# Unlock date to show tours of the following year (format: MM-DD)
TOUR_VISIBILITY_NEXT_YEAR_UNLOCK_AT=12-01
